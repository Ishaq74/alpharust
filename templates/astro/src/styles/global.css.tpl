:root { --bg: #ffffff; --fg: #1a1a1a; --brand: #0b3d91; }
body { font-family: system-ui, sans-serif; margin: 0; color: var(--fg); background: var(--bg); }
header, footer { padding: 1rem 2rem; background: var(--brand); color: #ffffff; }
header nav a { color: #ffffff; margin-right: 1rem; text-decoration: none; font-weight: 600; }
main { max-width: 48rem; margin: 2rem auto; padding: 0 1rem; }
