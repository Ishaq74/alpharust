---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & Omit<HTMLAttributes<"a">, "type"> & {
  variant?: "default" | "primary" | "secondary" | "outline" | "ghost" | "info" | "success" | "warning" | "error";
  size?: "sm" | "md" | "lg";
};

const { variant = "default", size = "md", class: className, ...rest } = Astro.props;
const Tag = Astro.props.href ? "a" : "div";
---

<Tag class={className} {...rest} data-slot="badge" data-variant={variant} data-size={size}>
  <slot />
</Tag>
