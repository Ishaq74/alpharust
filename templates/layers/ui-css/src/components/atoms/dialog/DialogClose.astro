---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  /** Habille un élément enfant (ex. <Button>) au lieu de rendre son propre <button>. */
  asChild?: boolean;
};

const { asChild = false, class: className, ...rest } = Astro.props;
---

{
  asChild ? (
    <span class={className} {...rest} data-slot="dialog-close" data-as-child>
      <slot />
    </span>
  ) : (
    <button type="button" class={className} {...rest} data-slot="dialog-close">
      <slot />
    </button>
  )
}
