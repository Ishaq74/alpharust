---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  variant?: "default" | "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg" | "icon-sm" | "icon" | "icon-lg";
};

const { variant = "outline", size = "icon", class: className, ...rest } = Astro.props;
---

<button type="button" class={className} data-variant={variant} data-size={size} aria-label="Next slide" {...rest} data-slot="carousel-next">
  <slot name="icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon="arrow-right"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg></slot>
  <slot><span class="sr-only">Next slide</span></slot>
</button>
