---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  align?: "inline-start" | "inline-end" | "block-start" | "block-end";
};

const { align = "inline-start", class: className, ...rest } = Astro.props;
---

<div class={className} role="group" data-align={align} {...rest} data-slot="input-group-addon">
  <slot />
</div>
