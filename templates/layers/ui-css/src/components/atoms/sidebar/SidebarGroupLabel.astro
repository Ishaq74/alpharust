---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  asChild?: boolean;
};

const { asChild = false, class: className, ...rest } = Astro.props;
---

<div class={className} data-sidebar="group-label" data-as-child={asChild ? "" : undefined} {...rest} data-slot="sidebar-group-label">
  <slot />
</div>
