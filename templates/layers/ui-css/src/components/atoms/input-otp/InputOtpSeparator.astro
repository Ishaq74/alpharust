---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<div aria-hidden="true" class={className} role="separator" {...rest} data-slot="input-otp-separator">
  <slot name="icon"><svg xmlns="http://www.w3.org/2000/svg" width="1.5rem" height="1.5rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icon="minus"><path d="M5 12h14"/></svg></slot>
</div>
