---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  /** Habille un élément enfant au lieu de rendre son propre <button>. */
  asChild?: boolean;
};

const { asChild = false, class: className, ...rest } = Astro.props;
---

{
  asChild ? (
    <div class={className} data-slot="alert-dialog-action" data-as-child>
      <slot />
    </div>
  ) : (
    <button type="button" class={className} data-variant="primary" {...rest} data-slot="alert-dialog-action">
      <slot />
    </button>
  )
}
